+		case SSL_Curve_secp256r1: secretLen = 32; break;
+		case SSL_Curve_secp384r1: secretLen = 48; break;
+		case SSL_Curve_secp521r1: secretLen = 66; break;
+		default: secretLen = 32; break;
+	}

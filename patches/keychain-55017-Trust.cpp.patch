+	CFArrayRef allowedAnchors = NULL;
+	// TLS12 GUARD: the SL CSSM CL crashes in DecodedCert::freeCertFieldData when
+	// allowedEVRootsForLeafCertificate parses certs via _copyFieldDataForOid.
+	//  - On EC leaves (any arch): CSSM can't parse the EC key -> crash. Skip.
+	//  - On i386 (any cert type incl. RSA): the 32-bit CSSM cert-field decode
+	//    crashes even on RSA certs (confirmed: apple.com RSA bus-errors on i386,
+	//    works on x86_64). Skip the EV pre-check on i386 entirely. EV is only a
+	//    status optimization; skipping means normal validation (certGroupVerify
+	//    + libcrypto fallback) still runs -> no security loss, no crash.
+	int tls12SkipEV = tls12LeafIsEC(mCerts);
+#if defined(__i386__) || defined(__x86_64__)
+	tls12SkipEV = 1;   /* i386 EV field-parse is crash-prone; always skip */
+#endif
+	if (!tls12SkipEV) {
+		allowedAnchors = allowedEVRootsForLeafCertificate(mCerts);
+	} else {
+		secdebug("evTrust", "TLS12: skipping EV pre-check (EC leaf or i386; CSSM would crash)");
+	}

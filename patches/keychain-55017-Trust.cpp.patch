+// TLS12 EC-leaf SecTrust fallback (tls12_trusteval.c). The SL CSSM x509 TP
+// cannot parse EC (P-256) leaf certs and throws CSSMERR_TP_INVALID_CERTIFICATE;
+// this libcrypto-based validator handles them (same fix as the SSL path).
+// tls12LeafIsEC guards the EV pre-check, which CRASHES (not just errors) in
+// DecodedCert::freeCertFieldData when CSSM parses an EC leaf.
+#include <Security/cssmerr.h>      /* CSSMERR_TP_INVALID_CERTIFICATE */
+#include <Security/cssmapple.h>    /* CSSM_APPLE_TP_SSL_OPTIONS */
+#include <Security/SecPolicy.h>    /* SecPolicyGetOID / SecPolicyGetValue */
+extern "C" int tls12TrustEvaluateOpenSSL(CFArrayRef certs,
+                                         const char *hostname, size_t hostlen);
+extern "C" int tls12LeafIsEC(CFArrayRef certs);

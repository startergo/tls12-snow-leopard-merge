         mTpReturn = err.osStatus();
         secdebug("trusteval", "certGroupVerify exception: %d", (int)mTpReturn);
+    }
+    // ---- TLS12 EC-leaf fallback ---------------------------------------
+    // The SL CSSM TP rejects modern chains two ways:
+    //   CSSMERR_TP_INVALID_CERTIFICATE - can't parse EC (P-256) leaf certs.
+    //   CSSMERR_TP_NOT_TRUSTED         - RSA chain to a root not in CSSM's own
+    //                                    store (e.g. DigiCert Global Root G2).
+    // Our libcrypto validator handles both, using the anchor bundle (which has
+    // the modern roots). If the SSL policy is in effect, pull the server name
+    // for a SAN hostname check; then run the validator. On success, rewrite
+    // mTpReturn to noErr BEFORE diagnoseOutcome() so the existing machinery
+    // maps it to kSecTrustResultUnspecified (trusted). RSA chains the CSSM TP
+    // already trusts never reach here (they return noErr).
+    if ((mTpReturn != CSSM_OK) && mFilteredCerts) {
+        const char *hn = NULL;
+        size_t hnlen = 0;
+        if (mPolicies) {
+            CFIndex pc = CFArrayGetCount(mPolicies);
+            for (CFIndex pi = 0; pi < pc; pi++) {
+                SecPolicyRef pol = (SecPolicyRef)CFArrayGetValueAtIndex(mPolicies, pi);
+                if (!pol) continue;
+                CSSM_OID oid; CSSM_DATA val;
+                memset(&oid, 0, sizeof(oid)); memset(&val, 0, sizeof(val));
+                if (SecPolicyGetOID(pol, &oid) == noErr &&
+                    oid.Length == CSSMOID_APPLE_TP_SSL.Length &&
+                    memcmp(oid.Data, CSSMOID_APPLE_TP_SSL.Data, oid.Length) == 0) {
+                    if (SecPolicyGetValue(pol, &val) == noErr && val.Data &&
+                        val.Length >= sizeof(CSSM_APPLE_TP_SSL_OPTIONS)) {
+                        const CSSM_APPLE_TP_SSL_OPTIONS *o =
+                            (const CSSM_APPLE_TP_SSL_OPTIONS *)val.Data;
+                        if (o->ServerName && o->ServerNameLen > 0) {
+                            hn = o->ServerName;
+                            hnlen = o->ServerNameLen;
+                        }
+                    }
+                    break;
+                }
+            }
+        }
+        if (tls12TrustEvaluateOpenSSL(mFilteredCerts, hn, hnlen) == 0) {
+            secdebug("trusteval",
+                "TLS12: chain VALID via libcrypto fallback (TP rejected: parse or untrusted-root)");
+            mTpReturn = noErr;
+        }

# ── TLS 1.2 Snow Leopard merge — .gitignore ──────────────────────────────
# Commit only the hand-edited source-merge work, scripts, and docs.
# Everything large and regenerable (downloaded by scripts/setup.sh) is ignored.

# macOS cruft
.DS_Store
**/.DS_Store

# Build output (regenerated by scripts/build-libsecurity-ssl.sh)
build/

# Downloaded tarballs (re-fetched by scripts/setup.sh)
downloads/

# Cross-compile SDK (extracted from downloads by scripts/setup.sh — huge)
sdk/

# Leopard reference patches (extracted from downloads by scripts/setup.sh)
patches/

# ── sources/ : ignore the pristine, regenerable Apple trees, but KEEP the
#    hand-edited merge target (libsecurity_ssl-55002) and the top-level
#    test programs (ssltest.c, algtest.c). ────────────────────────────────
sources/*
!sources/libsecurity_ssl-55002/
!sources/ssltest.c
!sources/algtest.c

# Within the kept merge target, ignore any stray build artifacts
sources/libsecurity_ssl-55002/**/*.o
sources/libsecurity_ssl-55002/**/*.dylib

# Secrets / local environment (never commit)
*.pem
*_rsa
*_rsa.pub
id_rsa*
*.key

# Local VM access config (real credentials) — keep config.sh.example tracked
config.sh

# ── stubs/ : Security/ and security_asn1/ are SYMLINKS generated by
#    scripts/post-setup.sh into the (un-committed) sources/libsecurity_asn1
#    and libsecurity_keychain trees. Committing them would create dangling
#    links on a fresh clone. Ignore them; keep only the hand-authored stubs
#    (ModuleAttacher_stub.c, security_utilities/debugging.h). ──────────────
stubs/Security/
stubs/security_asn1/
